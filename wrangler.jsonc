{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "portfolio",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "portfolio"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{ "pattern": "ibm.io", "custom_domain": true },
		{ "pattern": "www.ibm.io", "custom_domain": true }
	]
}
